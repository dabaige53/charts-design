{
  "name": "@charts-design/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "exports": {
    ".": {
      "types": "./dist/types/runtime-ui/src/index.d.ts",
      "import": "./dist/components.js"
    },
    "./styles.css": "./dist/app.css"
  },
  "scripts": {
    "build": "bun scripts/build.mjs && bun node_modules/typescript/bin/tsc -p tsconfig.build.json && bun scripts/build-state.mjs --record",
