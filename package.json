{
  "name": "charts-design",
  "version": "1.0.3",
  "description": "McKinsey-grade executive charts, KPI metric cards, interactive pivot tables, and dashboard generator. 麦肯锡风格图表设计与高管决策看板套件。",
  "bin": {
    "charts-design": "./bin/cli.js",
    "charts-design-runtime": "./bin/dashboard-runtime.js"
  },
  "scripts": {
    "test": "python3 -m pytest -q",
    "check": "node --check bin/cli.js && node --check skills/executive-charts/scripts/runtime_inspector.spec.js && python3 -m py_compile skills/executive-charts/scripts/dashboard_workspace.py skills/executive-charts/scripts/generate_dashboard.py skills/executive-charts/scripts/core/*.py",
    "runtime:build": "npm --prefix runtime-ui install && npm --prefix runtime-ui run build",
    "runtime:test": "python3 -m pytest tests/runtime -q && node --test tests/runtime/engine.test.mjs",
    "runtime:serve": "python3 -m dashboard_runtime serve",
    "runtime:mcp": "python3 -m dashboard_runtime mcp",
    "prepack": "npm --prefix runtime-ui run build"
  },
  "files": [
    "bin/",
    "skills/executive-charts/SKILL.md",
    "skills/executive-charts/references/",
    "skills/executive-charts/scripts/*.py",
    "skills/executive-charts/scripts/runtime_inspector.spec.js",
    "skills/executive-charts/scripts/core/*.py",
    "skills/executive-charts/scripts/README.md",
    "runtime-ui/*.mjs",
    "runtime-ui/package.json",
    "docs/dashboard-runtime.md",
    "pyproject.toml",
    "mcp.json",
    "README.md",
    "skills/analytical-reports/",
    "skills/executive-charts/examples/",
    "docs/generation-tracks.md",
    "dashboard_runtime/web/dist/app.js",
    "dashboard_runtime/web/dist/app.css",
    "dashboard_runtime/*.py",
    "dashboard_runtime/web/*.mjs",
    "dashboard_runtime/web/*.css",
    "dashboard_runtime/web/.npmignore",
    "dashboard_runtime/examples/*.md"
  ],
  "keywords": [
    "mckinsey",
    "charts",
    "dashboard",
    "echarts",
    "executive",
    "kpi",
    "tailwindcss",
    "data-visualization",
    "business-intelligence",
    "pivot-table",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dabaige53/charts-design.git"
  },
  "author": "dabaige53",
  "license": "MIT",
  "homepage": "https://github.com/dabaige53/charts-design#readme"
}
