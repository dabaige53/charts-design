{
  "name": "charts-design",
  "version": "1.2.42",
  "description": "Versioned dashboard data, metrics and MCP runtime with shared React UI components.",
  "bin": {
    "charts-design": "./bin/cli.js",
    "charts-design-runtime": "./bin/dashboard-runtime.js"
  },
  "scripts": {
    "setup": "bun bin/setup-environment.mjs",
    "native:install": "bun bin/install-native.mjs",
    "native:build": "bun bin/build-native.mjs",
    "release": "bun bin/release.mjs",
    "deploy:cloudbase": "bun bin/cloudbase-deploy.mjs",
    "deploy:cloudflare": "bunx --package wrangler@4.166.0 wrangler deploy --config deploy/cloudflare/wrangler.json",
    "ui:install": "bun install --cwd runtime-ui --frozen-lockfile --ignore-scripts",
    "ui:build": "bun run --cwd runtime-ui --bun build",
    "ui:prepare": "bun runtime-ui/scripts/prepare.mjs",
    "ui:typecheck": "bun run --cwd runtime-ui --bun typecheck",
    "ui:package": "bun runtime-ui/scripts/package.mjs",
    "ui:package:design": "bun runtime-ui/scripts/package-design.mjs",
    "test": "bun run test:unit && bun run test:components",
    "test:unit": "bun run native:test && bun test ./tests/runtime ./tests/development ./tests/deploy",
    "test:components": "bun run --cwd runtime-ui test:components",
    "test:container": "docker build -f deploy/Dockerfile -t charts-design:local . && bun tests/deploy/container-smoke.mjs --image charts-design:local",
    "check": "bun run check:skills && bun run check:docs && bun bin/check-js-syntax.mjs",
    "check:skills": "bun bin/check-skill-links.js",
    "check:docs": "bun bin/check-doc-links.js",
    "runtime:test": "cargo test --locked --manifest-path runtime-core/Cargo.toml && bun test ./tests/runtime",
    "runtime:serve": "bun bin/dashboard-runtime.js serve",
    "runtime:mcp": "bun bin/dashboard-runtime.js mcp",
    "deploy:init": "bun deploy/init.mjs",
    "test:data": "bun tests/acceptance/run.mjs seed",
    "test:function": "bun tests/acceptance/run.mjs verify",
    "test:performance": "bun tests/acceptance/run.mjs perf",
    "test:million": "bun tests/acceptance/run.mjs perf --rows 1000000",
    "native:check": "cargo fmt --manifest-path runtime-core/Cargo.toml --check && cargo clippy --locked --manifest-path runtime-core/Cargo.toml --all-targets -- -D warnings",
    "native:test": "cargo test --locked --manifest-path runtime-core/Cargo.toml",
    "postinstall": "node bin/postinstall.mjs"
  },
  "files": [
    "bin/cli.js",
    "bin/dashboard-runtime.js",
    "bin/native-runtime.js",
    "bin/mcp-runtime.js",
    "bin/install-native.mjs",
    "bin/postinstall.mjs",
    "skills/executive-charts/SKILL.md",
    "skills/executive-charts/references/",
    "skills/analytical-reports/",
    "runtime-core/Cargo.toml",
    "runtime-ui/dist/app.js",
    "runtime-ui/dist/app.css",
    "runtime-ui/dist/static-worker.js",
    "runtime-ui/dist/build.json",
    "mcp.json",
    "README.md",
    "AGENTS.md",
    "docs/README.md",
    "docs/implementation/",
    "docs/operations/",
    "docs/reference/",
    "docs/agent/",
    "cloudbase/migrations/"
  ],
  "keywords": [
    "mckinsey",
    "charts",
    "dashboard",
    "echarts",
    "executive",
    "kpi",
    "tailwindcss",
    "data-visualization",
    "business-intelligence",
    "pivot-table",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dabaige53/charts-design.git"
  },
  "author": "dabaige53",
  "license": "MIT",
  "homepage": "https://github.com/dabaige53/charts-design#readme",
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudbase/cli": "3.9.1"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  }
}
