{
  "name": "charts-design",
  "version": "1.2.15",
  "description": "Versioned dashboard data, metrics and MCP runtime with shared React UI components.",
  "bin": {
    "charts-design": "./bin/cli.js",
    "charts-design-runtime": "./bin/dashboard-runtime.js"
  },
  "scripts": {
    "setup": "bun bin/setup-environment.mjs",
    "release": "bun bin/release.mjs",
    "deploy:cloudbase": "bun bin/cloudbase-deploy.mjs",
    "ui:install": "bun install --cwd runtime-ui --frozen-lockfile",
    "ui:build": "bun run --cwd runtime-ui --bun build",
    "ui:prepare": "bun runtime-ui/scripts/prepare.mjs",
    "ui:typecheck": "bun run --cwd runtime-ui --bun typecheck",
    "ui:package": "bun runtime-ui/scripts/package.mjs",
    "ui:package:design": "bun runtime-ui/scripts/package-design.mjs",
    "python": "bun bin/python-runtime.js",
    "test": "bun run test:unit && bun run test:components",
    "test:unit": "bun bin/python-runtime.js -m pytest tests -q && bun test ./tests/runtime ./tests/development ./tests/deploy",
    "test:components": "bun run --cwd runtime-ui test:components",
    "test:container": "docker build -f deploy/Dockerfile -t charts-design:local . && bun bin/python-runtime.js tests/deploy/container_smoke.py --image charts-design:local",
    "check": "bun run check:skills && bun run check:docs && bun bin/check-js-syntax.mjs && bun bin/python-runtime.js -m py_compile skills/executive-charts/scripts/dashboard_workspace.py skills/executive-charts/scripts/core/*.py tests/deploy/container_smoke.py",
    "check:skills": "bun bin/check-skill-links.js",
    "check:docs": "bun bin/check-doc-links.js",
    "lint:py": "bun bin/python-runtime.js -m ruff check",
    "runtime:test": "bun bin/python-runtime.js -m pytest tests/runtime -q && bun test ./tests/runtime",
    "runtime:serve": "bun bin/dashboard-runtime.js serve",
    "runtime:mcp": "bun bin/dashboard-runtime.js mcp"
  },
  "files": [
    "bin/",
    "skills/executive-charts/SKILL.md",
    "skills/executive-charts/references/",
    "skills/executive-charts/scripts/*.py",
    "skills/executive-charts/scripts/core/*.py",
    "skills/executive-charts/scripts/README.md",
    "docs/implementation/dashboard-runtime.md",
    "docs/implementation/echarts-options.md",
    "docs/implementation/dynamic-encoding.md",
    "docs/images/dynamic-encoding-retail.png",
    "pyproject.toml",
    "mcp.json",
    "README.md",
    "skills/analytical-reports/",
    "docs/implementation/generation-tracks.md",
    "dashboard_runtime/*.py",
    "dashboard_runtime/web/*.mjs",
    "dashboard_runtime/web/dist/",
    "runtime-ui/package.json",
    "runtime-ui/dist/components.js",
    "runtime-ui/dist/app.css",
    "runtime-ui/dist/types/",
    "dashboard_runtime/examples/*.md",
    "docs/implementation/seaborn-backend.md",
    "docs/records/performance-results.json",
    "docs/implementation/project-runtime.md",
    "docs/operations/mcp-transport-diagnostics.md",
    "docs/operations/static-deployment.md",
    "docs/operations/self-hosted-server.md",
    "deploy/Dockerfile",
    "deploy/Dockerfile.dockerignore",
    "deploy/docker-compose.yml",
    "deploy/charts-design.service",
    "deploy/nginx.conf",
    "deploy/environment.example",
    "cloudbase/migrations/",
    "docs/operations/testing.md",
    "uv.lock",
    ".python-version",
    ".bun-version",
    "AGENTS.md",
    "docs/README.md",
    "docs/agent/",
    "docs/reference/",
    "docs/implementation/",
    "docs/operations/"
  ],
  "keywords": [
    "mckinsey",
    "charts",
    "dashboard",
    "echarts",
    "executive",
    "kpi",
    "tailwindcss",
    "data-visualization",
    "business-intelligence",
    "pivot-table",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dabaige53/charts-design.git"
  },
  "author": "dabaige53",
  "license": "MIT",
  "homepage": "https://github.com/dabaige53/charts-design#readme",
  "packageManager": "bun@1.3.8",
  "engines": {
    "bun": "1.3.8"
  },
  "devDependencies": {
    "@cloudbase/cli": "3.9.1"
  }
}
