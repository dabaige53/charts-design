  "libraries": [],
  "components": [
    {
      "name": "Alerts",
      "group": "反馈",
      "summary": "Global 在页面 Header 之上，用于全系统信息；Contextual 用于当前操作与状态，不能互换。"
    },
    {
      "name": "Avatars",
      "group": "身份",
      "summary": "头像使用圆形；有照片、姓名缩写、无照片无姓名三类。"
    },
    {
      "name": "Badges",
      "group": "反馈",
      "summary": "紧邻所指对象，计数上限显示 999+；状态徽章用于展示而不交互。"
    },
    {
      "name": "Breadcrumbs",
      "group": "导航",
      "summary": "显示 2–5 个层级；末项是当前位置，使用 Electric Blue。"
    },
    {
      "name": "Buttons",
      "group": "操作",
      "summary": "Primary、Secondary、Tertiary 表示交互优先级；尽可能每页一个主要按钮。"
    },
    {
      "name": "Cards",
      "group": "内容",
      "summary": "标题 1–3 行，建议 2 行；正文 2–5 行，建议 3–4 行。"
    },
    {
      "name": "Checkboxes",
      "group": "表单",
      "summary": "用于选择一项、多项或全部；按最可能选择或字母顺序排列。"
    },
    {
      "name": "DataTables",
      "group": "数据",
      "summary": "至少三列；表头与内容行均为 48px。"
    },
    {
      "name": "DatePicker",
      "group": "表单",
      "summary": "提供单日与日期范围选择；从输入框右侧日历入口展开。"
    },
    {
      "name": "Footers",
      "group": "导航",
      "summary": "提供 Large、Default、Condensed 版本及桌面、平板、移动布局。"
    },
    {
      "name": "Headers",
      "group": "导航",
      "summary": "提供桌面、平板、移动的浅色 Header，以及带或不带菜单入口的版本。"
    },
    {
      "name": "Links",
      "group": "操作",
      "summary": "Inline Link 保持周围文字的字号与颜色，默认下划线作为非颜色识别线索。"
    },
    {
      "name": "Modals",
      "group": "反馈",
      "summary": "仅用于需要集中注意力的关键内容或任务；打开后阻止底层页面交互。"
    },
    {
      "name": "MultiSelect",
      "group": "表单",
      "summary": "少量选择使用 Tags，已选项从候选列表移除；大量选择使用 Checkbox 与数量计数。"
    },
    {
      "name": "PageSwitcher",
      "group": "导航",
      "summary": "位于页面底部，Previous 与 Next 成对出现，导航到流程中的前后页面。"
    },
    {
      "name": "Pagination",
      "group": "导航",
      "summary": "用于分页内容；显示当前位置并支持跳页。"
    },
    {
      "name": "PopupMenu",
      "group": "操作",
      "summary": "文案直接对应保存、删除、下载等动作；分隔线划分操作组。"
    },
    {
      "name": "RadioButtons",
      "group": "表单",
      "summary": "用于互斥选项；纵向单列排列，按常用优先或字母顺序。"
    },
    {
      "name": "Select",
      "group": "表单",
      "summary": "用于从列表中选择一个选项；提供小、默认、大号和 Help Text 版本。"
    },
    {
      "name": "Sliders",
      "group": "表单",
      "summary": "提供单值、带图标单值和区间选择；需要时显示数值。"
    },
    {
      "name": "Tabs",
      "group": "导航",
      "summary": "用于同一上下文的 3–8 个区段；仅显示当前项内容，其余选择持续可见。"
    },
    {
      "name": "Tags",
      "group": "表单",
      "summary": "用于可选择、可移除的选项，适配多选输入；不与只读 Badge 混淆。"
    },
    {
      "name": "TextAreas",
      "group": "表单",
      "summary": "用于评论等多行文字；允许从右下角调整大小。"
    },
    {
      "name": "TextInputs",
      "group": "表单",
      "summary": "用于单行输入；Placeholder 不能替代 Label。"
    },
    {
      "name": "ToggleButtons",
      "group": "表单",
      "summary": "用于即时切换 On / Off；保留 Off、On、Disabled Off、Disabled On。"
    },
    {
      "name": "Tooltips",
      "group": "反馈",
      "summary": "用于解释工具或图标；通常一个词或一行短句。"
    }
  ],
