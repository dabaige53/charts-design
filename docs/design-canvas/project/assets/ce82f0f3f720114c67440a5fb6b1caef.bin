        "value": "Displayed headline text, including unit, e.g. \"484 万元\"",
        "yoy": "Optional signed comparison: number or text such as \"+4.8%\" (red = increase, green = decrease)",
        "subLabel": "Left segment label and value",
        "subVal": "Right segment label and value",
        "segLeftWidth": "Left share 0-100",
        "segRightWidth": "Right share; the two sum to 100"
      },
      "bind": [],
      "example": {
        "label": "收入结构",
        "value": "484 万元",
        "segLeftWidth": "72%",
        "segRightWidth": "28%",
        "subLabel": "国内 348 万元",
        "subVal": "国际 136 万元"
      }
    },
    {
      "code": "mc10",
      "name": "中位数极差分布卡",
      "question": "What is typical, and how spread out is a skewed distribution?",
      "fields": {
        "label": "Card label (the component title replaces it in the runtime header)",
        "value": "Displayed median text",
        "valueLabel": "Label before the value (default 中位数)",
        "stats": "Finite numbers {min, p25, median, p75, max}, ascending",
        "meanText": "Optional mean text",
        "sampleText": "Optional sample size text"
      },
      "bind": [],
      "example": {
        "label": "客单票价",
        "value": "¥680",
        "meanText": "均值 ¥742.5",
        "sampleText": "5,420 万张",
        "stats": {
          "min": 320,
          "p25": 540,
          "median": 680,
          "p75": 920,
          "max": 1850
        }
      }
    },
    {
      "code": "mc11",
      "name": "环形进度卡",
      "question": "How complete is a goal, at a glance?",
      "fields": {
        "label": "Card label (the component title replaces it in the runtime header)",
        "value": "Displayed headline text, including unit, e.g. \"484 万元\"",
        "yoy": "Optional signed comparison: number or text such as \"+4.8%\" (red = increase, green = decrease)",
        "subLabel": "Footer label",
        "subVal": "Footer value text",
        "percent": "Completion 0-100 (above 100 fills the ring and shows the real percent)",
        "trendLabel": "Optional neutral note"
      },
      "bind": [
        "value",
        "percent",
        "subVal"
      ],
      "example": {
        "label": "年度收入目标",
        "value": "1,840 万元",
        "percent": 92,
        "trendLabel": "按月累计",
        "subLabel": "年度目标",
        "subVal": "2,000 万元"
      }
    },
    {
      "code": "mc12",
      "name": "迷你柱趋势卡",
      "question": "How does the latest period compare with the previous few?",
      "fields": {
        "label": "Card label (the component title replaces it in the runtime header)",
        "value": "Displayed headline text, including unit, e.g. \"484 万元\"",
        "yoy": "Optional signed comparison: number or text such as \"+4.8%\" (red = increase, green = decrease)",
        "subLabel": "Footer label",
        "subVal": "Footer value text",
        "sparkMonths": "Period labels",
        "sparkData": "Finite values, same length; the last bar is emphasized",
        "trendLabel": "Optional neutral note"
      },
      "bind": [
        "value",
        "yoy",
        "subVal",
        "timeField → sparkMonths/sparkData"
      ],
      "example": {
        "label": "月度新增客户",
        "value": "1,268 户",
        "yoy": "+12.4%",
        "sparkMonths": [
          "04",
          "05",
          "06",
          "07",
          "08",
          "09"
        ],
        "sparkData": [
          940,
          1012,
          1105,
          990,
          1180,
          1268
        ],
        "subLabel": "近六个月均值",
        "subVal": "1,083 户"
      }
    },
    {
      "code": "mc13",
      "name": "子弹目标卡",
      "question": "Is actual above target, and in which qualitative range?",
      "fields": {
        "label": "Card label (the component title replaces it in the runtime header)",
        "value": "Displayed headline text, including unit, e.g. \"484 万元\"",
        "yoy": "Optional signed comparison: number or text such as \"+4.8%\" (red = increase, green = decrease)",
        "subLabel": "Footer label",
        "subVal": "Footer value text",
        "actual": "Finite actual value",
        "target": "Finite target value (marker)",
        "ranges": "Up to three ascending range limits in the same unit",
        "rangeBasis": "value (absolute limits, default) or target (limits are fractions of target, e.g. [0.8, 1.0]; use when filters recompute target)",
        "max": "Optional scale maximum",
        "unit": "Unit used when target text is derived"
      },
      "bind": [
        "value",
        "actual",
        "target",
        "subVal"
      ],
      "example": {
        "label": "季度营收对目标",
        "value": "484 万元",
        "actual": 484,
        "target": 525,
        "ranges": [
          400,
          500
        ],
        "unit": "万元",
        "subLabel": "季度目标",
        "subVal": "525 万元"
      }
    },
    {
      "code": "mc14",
      "name": "双期对比卡",
      "question": "How does this period compare with the prior period?",
      "fields": {
        "label": "Card label (the component title replaces it in the runtime header)",
        "value": "Displayed headline text, including unit, e.g. \"484 万元\"",
        "yoy": "Optional signed comparison: number or text such as \"+4.8%\" (red = increase, green = decrease)",
        "subLabel": "Footer label",
        "subVal": "Footer value text",
        "currentLabel": "Current period label",
        "currentValue": "Finite current value",
        "priorLabel": "Prior period label",
        "priorValue": "Finite prior value",
        "currentText": "Optional display text",
        "priorText": "Optional display text",
        "deltaLabel": "Badge label (default 较上期)",
        "unit": "Unit for derived text"
      },
      "bind": [
        "value",
        "currentValue",
        "priorValue",
        "yoy",
        "subVal"
      ],
      "example": {
        "label": "季度收入对比",
        "value": "484 万元",
        "yoy": "+24.1%",
        "currentLabel": "2026Q3",
        "currentValue": 484,
        "priorLabel": "2025Q3",
        "priorValue": 390,
        "unit": "万元"
      }
    },
    {
      "code": "mc15",
      "name": "指标清单卡",
      "question": "What are 2-4 related sub-metrics of one theme?",
      "fields": {
        "label": "Card label (the component title replaces it in the runtime header)",
        "value": "Optional headline text",
        "valueLabel": "Optional note beside it",
        "items": "1-4 objects {label, value, delta?}; delta is a signed comparison"
      },
      "bind": [],
      "example": {
        "label": "渠道收入",
        "value": "484 万元",
        "valueLabel": "合计",
        "items": [
          {
            "label": "直销",
            "value": "226 万元",
            "delta": "+8.2%"
          },
          {
            "label": "分销",
            "value": "172 万元",
            "delta": "-3.1%"
          },
          {
            "label": "电商",
            "value": "86 万元",
            "delta": "+21.5%"
          }
        ]
      }
    },
    {
      "code": "mc16",
      "name": "大字主指标卡",
      "question": "What is the single number that matters most, and the takeaway?",
      "fields": {
        "label": "Card label (the component title replaces it in the runtime header)",
        "value": "Displayed headline text, including unit, e.g. \"484 万元\"",
        "yoy": "Optional signed comparison: number or text such as \"+4.8%\" (red = increase, green = decrease)",
        "subLabel": "Footer label",
        "subVal": "Footer value text",
        "note": "Authored one-line takeaway (at most 120 characters)"
      },
      "bind": [
        "value",
        "yoy",
        "subVal"
      ],
      "example": {
        "label": "北极星 · 月活跃客户",
        "value": "12.6 万",
        "yoy": "+9.8%",
