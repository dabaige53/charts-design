  "narrative": {
    "northStar": "清晰层级、精确结构与稳定节奏",
    "overview": "界面用于查看经营数据、比较指标、调整筛选和追溯计算依据。以紧凑密度、稳定布局和清楚的操作反馈组织内容。页面使用淡灰底，数据组件使用白色表面；操作色保持克制，数据色继续承担图表编码。",
    "keyCharacteristics": [
      "层级清楚：页面标题、组件标题、主数值和辅助文字各有用途。",
      "结构精确：共享组件统一尺寸、内容边距与状态。",
      "节奏稳定：数据更新保留原内容，不让加载提示挤动卡片。",
      "内容可信：指标定义、公式和明细来自当前组件绑定。"
    ],
    "rules": [
      {
        "name": "The Source Separation Rule",
        "body": "操作变量、图表数据色和归档参考分别维护；复制参考页面时不能覆盖当前运行变量。",
        "section": "colors"
      },
      {
        "name": "The Title Role Rule",
        "body": "新组件复用组件标题角色，不按图表类型自行添加一套大标题。",
        "section": "typography"
      },
      {
        "name": "The Stable Update Rule",
        "body": "查询期间保留已有组件。更新提示不占据卡片正文空间，局部操作只更新相关内容。",
        "section": "layout"
      }
    ],
    "dos": [
      "Do 复用共享组件和当前语义变量，修改后同步设计记录。",
      "Do 保持标题角色、表头与数据对齐、图标尺寸和边距一致。",
      "Do 用真实绑定解释指标，保留单位、筛选范围和明细入口。",
      "Do 在局部更新中保留内容、选择状态和减少动态效果路径。",
      "Do 分别维护设计资产、运行源码与打包产物。"
    ],
    "donts": [
      "Don't 将归档 PDF 的字体、操作色或尺寸写成当前产品已经使用的值。",
      "Don't 将讨论、构建成功或静态预览写成 MCP 宿主已完成验收。",
      "Don't 在数据更新时清空整张卡片，或用加载文字挤动图表。",
      "Don't 为缺少定义的指标编造公式、阈值或来源。",
      "Don't 用一套全局圆角或图表大标题覆盖现有组件差异。"
    ]
  }
}
