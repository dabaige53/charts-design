{
  "name": "charts-design",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "containers": [{
    "class_name": "ChartsWorkspace",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "../Dockerfile", "build_context": "../.." } }
  }],
  "durable_objects": { "bindings": [{ "name": "CHARTS", "class_name": "ChartsWorkspace" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChartsWorkspace"] }],
  "triggers": { "crons": ["0 */6 * * *"] },
  "observability": { "enabled": false }
}
