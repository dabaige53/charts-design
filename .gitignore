# Ignore all dotfiles and dot directories
.*
!.gitignore
!.github/
!.github/**

# Explicitly ignore common agent/IDE/Stitch dotdirs
.agents/
.claude/
.codex/
.cursor/
.stitch/
.tempmediaStorage/
.system_generated/
.gemini/

# Ignore environments & secrets
*.env
*.env.*
.env*
*secret*
*token*
*.key
*.pem
*.pfx

# Python caches and compiled files
__pycache__/
*.egg-info/
build/
*.py[cod]
*$py.class
dist/test_*
dist/*verified*
tests/test_output/

# Runtime dependencies, local data and review artifacts
node_modules/
boards/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
dashboard_runtime/web/dist/
runtime-source.tar.gz
runtime-tests.txt
runtime-screenshot.png
component-review/
report-preview.png
runtime-bound-filter.png
runtime-icons-gallery.png
runtime-original-restored.png

# System files
.DS_Store
Thumbs.db

# Local acceptance reports may contain user data and machine paths.
dist/local-data-acceptance/
core-tests.txt

